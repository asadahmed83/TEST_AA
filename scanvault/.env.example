# --- Web / Android app (Vite, exposed to the client) ---
# Google OAuth client ID (Web application type) with the Drive API enabled.
# Leave empty to use the built-in demo cloud for Google Drive.
VITE_GOOGLE_CLIENT_ID=
# Azure app registration (SPA platform) client ID for OneDrive / Microsoft Graph.
# Leave empty to use the built-in demo cloud for OneDrive.
VITE_MS_CLIENT_ID=
# Base URL of the AI proxy (server/index.ts). Defaults to same-origin /api.
# For the Android build point this at your deployed proxy, e.g. https://ai.example.com/api
VITE_AI_BASE_URL=
# Must match APP_TOKEN on the server if you set one.
VITE_AI_APP_TOKEN=

# --- AI proxy server (never shipped to the client) ---
ANTHROPIC_API_KEY=
PORT=8787
# Optional shared secret the app must send in the X-App-Token header.
APP_TOKEN=
# Comma-separated list of allowed browser origins (Capacitor Android uses https://localhost).
ALLOWED_ORIGINS=http://localhost:5173,https://localhost
